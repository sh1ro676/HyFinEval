# HyFinEval 环境变量模板
# 用法：复制本文件为 .env（即 D:/finance_samples/.env）并填入真实 key。
#       .env 已被 .gitignore 忽略，切勿提交真实 key。
#       不填 HY3_API_KEY 也能跑——自动以基线示例运行（基于本地真实指标，无需联网）。

# 【经实测可用的 TokenHub 配置（腾讯混元 Hy3 国际站）】
HY3_API_KEY=your_tokenhub_key_here
HY3_BASE_URL=https://tokenhub-intl.tencentmaas.com/v1
HY3_MODEL=hy3
