# 腾讯混元 / Hy3 OpenAI 兼容 API 配置模板
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实 key

# API key（必填，启用真实模型生成 / 裁判）
HY3_API_KEY=

# OpenAI 兼容接口地址（默认腾讯云混元托管；自部署 Hy3 改成你的 endpoint）
HY3_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1

# 模型名（云端可用 hunyuan-turbo / hunyuan-t1-latest 等；自部署填你的模型名）
HY3_MODEL=hunyuan-turbo
